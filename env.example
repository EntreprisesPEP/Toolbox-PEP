# Variables d'environnement requises pour ce projet.
# A configurer dans Vercel : Project Settings > Environment Variables
# (memes valeurs que dans l'ancien projet pep-planification)

NEXT_PUBLIC_SUPABASE_URL=https://qhiriieengchuzauweto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Mot de passe pour le mode animateur de Planification hebdomadaire.
# Reste cote serveur, jamais visible dans le navigateur.
ANIMATEUR_PASSWORD=

# --- Ordre du jour ---
# Utilise maintenant NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY
# ci-dessus (meme projet Supabase partage "Toolbox", schema ordre_du_jour).
# Les variables NEXT_PUBLIC_ORDREDUJOUR_SUPABASE_* et ORDREDUJOUR_SUPABASE_*
# ne sont plus utilisees et peuvent etre supprimees de Vercel.
#
# Cle VAPID publique (visible navigateur)
NEXT_PUBLIC_ORDREDUJOUR_VAPID_PUBLIC_KEY=
# Meme cle VAPID publique, cote serveur (doit etre IDENTIQUE a celle du dessus)
ORDREDUJOUR_VAPID_PUBLIC_KEY=
# Cle VAPID privee (reste cote serveur, jamais visible)
ORDREDUJOUR_VAPID_PRIVATE_KEY=
# Cle API Resend pour l'envoi de courriels (reste cote serveur)
RESEND_API_KEY=
